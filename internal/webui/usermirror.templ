package webui

templ userMirrorBody(prefix string, csrf string, v mirrorView, flash Flash) {
	<h2>Mirror your reading positions</h2>
	<p>Keep your reading position in step with another KOReader sync server. Only your account is mirrored.</p>
	@adminFlash(flash)
	<section class="card">
		<form method="post" action={ prefix + "settings/mirror" } autocomplete="off">
			<input type="hidden" name="csrf" value={ csrf }/>
			<label class="check">
				if v.Config.Enabled {
					<input type="checkbox" name="enabled" checked/>
				} else {
					<input type="checkbox" name="enabled"/>
				}
				Enable mirroring
			</label>
			<label>Peer URL <input name="base_url" type="url" value={ v.Config.BaseURL } placeholder="https://reader.example/sync" maxlength="4096"/></label>
			<label>Peer username <input name="remote_user" value={ v.Config.RemoteUser } autocomplete="username" maxlength="4096"/></label>
			<label>
				Authentication
				<select name="auth_mode">
					if v.Config.RemotePassword != "" {
						<option value="kosync">KOReader key (standard)</option><option value="basic" selected>HTTP Basic (Calibre-Web)</option>
					} else {
						<option value="kosync" selected>KOReader key (standard)</option><option value="basic">HTTP Basic (Calibre-Web)</option>
					}
				</select>
			</label>
			<label>Peer password <input name="remote_password" type="password" autocomplete="new-password" placeholder={ mirrorPasswordPlaceholder(v.HasKey) } maxlength="4096"/></label>
			<p class="muted">Leave the password blank to keep the saved credential for the same URL, username and authentication method. Enter it again when changing any of these.</p>
			<p class="muted">Standard KOReader sync uses a key derived from your password. HTTP Basic uses the password itself. The saved credential is encrypted and never shown here.</p>
			<button type="submit" class="primary">Save and test connection</button>
		</form>
	</section>
	<p>Changes apply within a few seconds without restarting the server. Positions cross as percentages; exact locations are not shared between different reader systems.</p>
}
